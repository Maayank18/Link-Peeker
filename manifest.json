{
  "manifest_version": 3,
  "name": "Link Peeker",
  "version": "1.1",
  "description": "Smart, privacy-focused link previews.",
  "permissions": [
    "scripting", 
    "activeTab", 
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Link Peeker"
  }
}